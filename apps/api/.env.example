# Copy to .env and adjust for your machine.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Local PostgreSQL (see README for setup)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/montra

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Authentication. JWT_SECRET signs access tokens and is required in production:
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Left blank outside production, a random secret is generated on every start.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Requests per IP per minute: register + login, and refresh.
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=30

# Demo accounts for the competition judges, created by `npm run db:seed`.
# Leave an account's email/password blank to skip it. Passwords: 10–128 characters.
# The API also reads the two emails: these accounts cannot be deleted from Settings.
# Never commit real values — set them in .env locally and in your host's secrets.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_OWNER_NAME=
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
DEMO_VIEWER_NAME=

# Stripe billing (test mode while developing). Without STRIPE_SECRET_KEY the
# paid plans show as "Coming soon". Outside production only test keys are accepted.
# Secret key: Stripe dashboard → Developers → API keys (sk_test_…). Never commit it.
STRIPE_SECRET_KEY=
# Signs the events Stripe sends (whsec_…). Locally, run
#   stripe listen --forward-to localhost:4000/api/v1/billing/webhook --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed
# and copy the secret it prints.
STRIPE_WEBHOOK_SECRET=
# The products behind the paid plans; each needs a monthly recurring default price.
STRIPE_PRODUCT_PRO=prod_VgQotbB4j1nCJr
STRIPE_PRODUCT_BUSINESS=prod_VgQoENJlxYKVGX
# Where the web app runs, for Stripe's return links after checkout and the portal.
WEB_APP_URL=http://localhost:5173
