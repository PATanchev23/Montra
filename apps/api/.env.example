# Copy to .env and adjust for your machine.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Local PostgreSQL (see README for setup)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/montra

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Authentication. JWT_SECRET signs access tokens and is required in production:
# 32+ random characters, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Left blank outside production, a random secret is generated on every start.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Requests per IP per minute: register + login, and refresh.
AUTH_RATE_LIMIT_MAX=10
REFRESH_RATE_LIMIT_MAX=30

# Demo accounts for the competition judges, created by `npm run db:seed`.
# Leave an account's email/password blank to skip it. Passwords: 10–128 characters.
# Never commit real values — set them in .env locally and in your host's secrets.
DEMO_OWNER_EMAIL=
DEMO_OWNER_PASSWORD=
DEMO_OWNER_NAME=
DEMO_VIEWER_EMAIL=
DEMO_VIEWER_PASSWORD=
DEMO_VIEWER_NAME=
