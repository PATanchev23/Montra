// Montra data model.
//
// Business is the tenant root. Every financial record hangs off a
// Business and is always queried scoped by businessId. Users reach a business
// only through a Membership, which is the single source of truth for access.
//
// Conventions:
//   - ids are cuids
//   - money is stored as integer cents (Int), never floats
//   - calendar dates use @db.Date; instants use timestamptz
//   - invariants Prisma cannot express (CHECK constraints) live in the
//     migration SQL and are listed in comments next to the field

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Identity ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  /// Stored trimmed and lower-cased (CHECK constraint), so uniqueness is case-insensitive.
  email        String   @unique
  name         String
  /// argon2id hash. Never selected into API responses.
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  memberships Membership[]
  sessions    Session[]
  onboarding  OnboardingProgress?
  imports     ImportBatch[]
}

/// One signed-in device. The refresh token itself lives only in an httpOnly
/// cookie; the database keeps its SHA-256 hash so a leak cannot be replayed.
model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime  @db.Timestamptz(3)
  /// Set on logout and on rotation; a revoked token presented again signals theft.
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Tenancy ──────────────────────────────────────────────────────────────

enum MembershipRole {
  /// Full access to the business, including changes.
  OWNER
  /// Read-only access (e.g. the competition judges' demo account).
  VIEWER
}

model Business {
  id                       String   @id @default(cuid())
  slug                     String   @unique
  name                     String
  currency                 String   @default("EUR") @db.Char(3)
  timezone                 String   @default("Europe/Sofia")
  /// Free-form business type collected during onboarding, e.g. "Consumer electronics".
  industry                 String?
  /// Month the financial year starts, 1–12 (CHECK constraint).
  fiscalYearStartMonth     Int      @default(1)
  /// Optional safety buffer for cash-flow warnings, in cents (CHECK >= 0).
  lowBalanceThresholdCents Int?
  createdAt                DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)

  memberships  Membership[]
  onboarding   OnboardingProgress?
  transactions Transaction[]
  imports      ImportBatch[]
}

/// Grants a user access to a business. Every business-scoped API request is
/// authorised by looking up (userId, businessId) here.
model Membership {
  userId     String
  businessId String
  role       MembershipRole @default(OWNER)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
}

// ── Onboarding ───────────────────────────────────────────────────────────

enum OnboardingStep {
  BUSINESS_DETAILS
  FINANCIAL_PREFERENCES
  REVIEW
}

/// A user's resumable journey from a fresh account to their first business.
///
/// - No row: the user has not started onboarding.
/// - completedAt null: in progress — resume at currentStep with the saved draft.
/// - completedAt set: finished; businessId points at the business it created
///   (CHECK constraint). Deleting that business removes this row, so the user
///   starts onboarding afresh.
///
/// Users who join an existing business (e.g. the VIEWER demo account) need no
/// onboarding: having a membership is enough.
model OnboardingProgress {
  userId      String         @id
  currentStep OnboardingStep @default(BUSINESS_DETAILS)
  /// Partial answers, validated by the API's Zod schema on every save.
  draft       Json           @default("{}")
  completedAt DateTime?      @db.Timestamptz(3)
  businessId  String?        @unique
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ── Money ────────────────────────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
}

/// Where imported data came from. Transactions entered by hand have none.
enum ImportSource {
  /// The official Montra template (CSV or XLSX).
  MONTRA_TEMPLATE
  /// Any other CSV, read through a column mapping.
  GENERIC_CSV
  /// Any other XLSX workbook (first sheet), read through a column mapping.
  GENERIC_EXCEL
}

/// One movement of money into or out of a business, in the business currency.
model Transaction {
  id            String          @id @default(cuid())
  businessId    String
  type          TransactionType
  /// Always positive, in cents (CHECK > 0); `type` gives the direction.
  amountCents   Int
  /// Not blank (CHECK constraint).
  description   String
  /// Free-form label, e.g. "Advertising". Not blank (CHECK constraint).
  category      String
  date          DateTime        @db.Date
  /// Null for transactions entered by hand; set with importBatchId (CHECK constraint).
  importSource  ImportSource?
  importBatchId String?
  /// The source system's own id (an External ID column in the file). Unique per
  /// business, so re-importing the same record is always recognised.
  externalId    String?
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(3)

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Deleting an import's record keeps the transactions it created.
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([businessId, externalId])
  // History pages: newest first, ties broken by creation then id.
  @@index([businessId, date(sort: Desc), createdAt(sort: Desc), id(sort: Desc)])
  @@index([businessId, type, date])
  @@index([businessId, category])
  @@index([importBatchId])
}

// ── Imports ──────────────────────────────────────────────────────────────

enum ImportFileFormat {
  CSV
  XLSX
}

enum ImportStatus {
  /// Uploaded; required columns or settings still need mapping.
  AWAITING_MAPPING
  /// Preview available; nothing is saved until the owner confirms.
  READY
  /// Confirmed. Individual records may still have been skipped or invalid.
  COMPLETED
  /// Confirmed, but every record was invalid, so nothing was imported.
  FAILED
  CANCELLED
  /// Not confirmed within the time limit.
  EXPIRED
}

/// One uploaded file and what became of it.
///
/// The file itself is never stored. While awaiting confirmation, the parsed
/// cells are kept in pendingData so the owner can map columns and review a
/// preview; they are cleared as soon as the import finishes, is cancelled or
/// expires (CHECK constraint).
model ImportBatch {
  id              String           @id @default(cuid())
  businessId      String
  /// Who uploaded it; kept if that user is later deleted.
  createdById     String?
  source          ImportSource
  fileFormat      ImportFileFormat
  fileName        String
  fileSize        Int
  /// SHA-256 of the file, hex: recognises the same file uploaded again.
  fileSha256      String           @db.Char(64)
  status          ImportStatus
  /// Counts of records found and their outcome (CHECK >= 0; once finished,
  /// imported + skipped + failed = total).
  totalRecords    Int              @default(0)
  importedRecords Int              @default(0)
  skippedRecords  Int              @default(0)
  failedRecords   Int              @default(0)
  /// Column mapping for template and generic files.
  mapping         Json?
  /// Parsed header and rows, only while awaiting confirmation.
  pendingData     Json?
  /// When an unconfirmed upload is discarded.
  expiresAt       DateTime         @db.Timestamptz(3)
  completedAt     DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([businessId, createdAt(sort: Desc)])
  @@index([businessId, fileSha256])
  @@index([businessId, status])
  @@index([createdById])
}
