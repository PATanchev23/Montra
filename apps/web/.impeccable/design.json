      "html": "<button class=\"ds-btn-primary\">Add transaction</button>",
      "css": ".ds-btn-primary{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;align-items:center;height:36px;padding:0 14px;border:0;border-radius:var(--radius-control,10px);background:var(--accent,#171717);color:var(--accent-ink,#fff);font-size:13px;line-height:20px;font-weight:500;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:var(--accent-hover,#333331)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent,#171717);outline-offset:2px}.ds-btn-primary:disabled{opacity:.45;cursor:not-allowed}"
