    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segmented-track",
      "description": "Pill track with a gliding ink pill; the capsule as a control.",
      "html": "<div class=\"ds-seg\" role=\"group\"><button class=\"ds-seg-item\">7 days</button><button class=\"ds-seg-item is-active\">30 days</button><button class=\"ds-seg-item\">90 days</button></div>",
      "css": ".ds-seg{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:inline-flex;padding:4px;border-radius:9999px;background:var(--hover,#eeeeeb)}.ds-seg-item{height:32px;padding:0 16px;border:0;border-radius:9999px;background:transparent;color:var(--ink-2,#454543);font:500 13px/20px 'Geist Variable',ui-sans-serif,sans-serif;cursor:pointer;transition:color .15s,background-color .15s}.ds-seg-item:hover{color:var(--ink,#171717)}.ds-seg-item.is-active{background:var(--accent,#171717);color:var(--accent-ink,#fff)}.ds-seg-item:focus-visible{outline:2px solid var(--accent,#171717);outline-offset:2px}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Flat list; the current page is the one ink pill.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item is-active\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1\"/></svg>Dashboard</a><a class=\"ds-nav-item\" href=\"#\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg>Transactions</a></nav>",
      "css": ".ds-nav{font-family:'Geist Variable',ui-sans-serif,system-ui,sans-serif;display:flex;flex-direction:column;gap:4px;width:216px;padding:16px;background:var(--sidebar,#f2f2ef)}.ds-nav-item{display:flex;align-items:center;gap:14px;height:44px;padding:0 14px;border-radius:var(--radius-control,10px);color:var(--ink-2,#454543);font-size:14px;text-decoration:none;transition:background-color .15s,color .15s}.ds-nav-item:hover{background:var(--hover,#eeeeeb);color:var(--ink,#171717)}.ds-nav-item.is-active{background:var(--accent,#171717);color:var(--accent-ink,#fff);font-weight:500}.ds-nav-item:focus-visible{outline:2px solid var(--accent,#171717);outline-offset:2px}"
    },
    {
      "name": "Badges",
